# Runtime environment variable examples. These paths are intentionally not fixed.
# The Python checker defaults to ./data and ./metadata/data_split.csv.

# Windows PowerShell (local RGB and masks):
# $env:UC_FOODWASTE_DATA_ROOT = (Resolve-Path .\data).Path

# Windows PowerShell (optional local NPZ copy):
# $env:UC_FOODWASTE_NPZ_DIR = 'D:\path\to\data_processed_multimodal\images'

# Colab (after mounting Drive):
# os.environ['UC_FOODWASTE_DATA_ROOT'] = '/content/drive/MyDrive/path/to/uc-foodwaste-data'
# os.environ['UC_FOODWASTE_NPZ_DIR'] = '/content/drive/MyDrive/path/to/data_processed_multimodal/images'
# os.environ['UC_FOODWASTE_SPLIT_CSV'] = '/content/drive/MyDrive/path/to/data_split.csv'
